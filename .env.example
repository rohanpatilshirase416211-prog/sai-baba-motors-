# साईबाबा मोटर्स — Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Local MongoDB, MongoDB Atlas, or leave default for automatic In-Memory database)
MONGODB_URI=mongodb://127.0.0.1:27017/saibabamotors

# JWT Secret for Admin Authentication
JWT_SECRET=saibaba_motors_super_secure_jwt_secret_key_2026

# Client URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# Modular Cloud Image Uploads (Cloudinary - Optional)
# If left empty, local disk storage under /server/uploads is automatically used
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
